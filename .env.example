# Syncfusion Community License — client-side registration at app startup (Phase 4)
VITE_SYNCFUSION_LICENSE=

# Contact the developer. Visible to signed-in students; Vite bakes it in at build.
# Not a secret. Leave empty to allow zip download without opening an email.
VITE_DEVELOPER_EMAIL=stephen.mckitrick@icloud.com

# AWS Amplify / Cognito (filled when Amplify is configured)
VITE_AWS_REGION=
VITE_COGNITO_USER_POOL_ID=
VITE_COGNITO_USER_POOL_CLIENT_ID=
VITE_COGNITO_IDENTITY_POOL_ID=

# Amplify Gen 2 may emit amplify_outputs.json instead of the Cognito vars above.
# Commit only if it contains no secrets; prefer hosting env for sensitive values.

# xAI (Grok) — SERVER-SIDE ONLY (Amplify Function / backend). Never use a VITE_ prefix.
# The browser must not receive this key; call generation/grading through your API.
XAI_API_KEY=

# Course pack upload (local scripts only — Cognito owner for S3 + CourseChunk rows)
INGEST_EMAIL=
INGEST_PASSWORD=

# Embeddings — batch script + Lambda embedQuery (single vector space)
# xAI /v1/embeddings was not available; use Bedrock Titan Embed Text v2.
EMBEDDING_PROVIDER=bedrock
EMBEDDING_MODEL=amazon.titan-embed-text-v2:0
BEDROCK_REGION=us-east-2
# Optional batch knobs: EMBED_CHUNK_SIZE=800 EMBED_CHUNK_OVERLAP=120 EMBED_MAX_CHAPTER_CHARS=40000
# AWS_PROFILE=steve-copilot for local npm run embed:course
